# You normally don't need to copy this by hand: `npm run setup:api` creates `.env` from it and fills the
# passwords with generated values. To do it yourself:   cp .env.example .env   and fill in the blanks.
# `.env` is git-ignored. One file feeds both apps:
#   - apps/api/scripts/*.sh  read it to set up and run the Frappe bench
#   - apps/web               loads it through dotenv-cli (see its package.json scripts)
# Keep comments on their own line; values are plain KEY=VALUE.

# ── Backend: Frappe / bench ──────────────────────────────────────────────────────────────────────────
# Frappe branch bench clones. version-16 needs Python 3.14 + Node >= 24.
# Use version-15 to stay on an older Node (needs Node >= 20.9 for the web app anyway).
FRAPPE_BRANCH=version-16

# Site name. It is also the folder under apps/api/bench/sites and seeds the MariaDB database name.
FRAPPE_SITE_NAME=todo.localhost

# Password for the site's `Administrator` account (Frappe desk at http://127.0.0.1:8000/app). Required;
# generated by `npm run setup:api` if left empty.
FRAPPE_ADMIN_PASSWORD=

# ── Backend: MariaDB ─────────────────────────────────────────────────────────────────────────────────
# bench logs in as this account once, to create the site's database and user. Required.
# Homebrew's MariaDB `root` only accepts the OS user root (unix_socket), so it can't be used with a
# password. If MARIADB_ROOT_PASSWORD is empty, `npm run setup:api` switches the username to
# `frappe_admin`, generates a password, and creates that account (using your macOS user, which Homebrew
# makes a MariaDB admin over the socket). Set both values yourself to use an account you already have.
MARIADB_ROOT_USERNAME=root
MARIADB_ROOT_PASSWORD=

# Optional: only if MariaDB's socket isn't at the default /tmp/mysql.sock.
# MYSQL_UNIX_PORT=/tmp/mysql.sock

# ── Backend: demo end-user (created by `npm run setup:api`) ──────────────────────────────────────────
# A user who holds only the "Todo User" role: can use the web app, cannot open the Frappe desk.
# A brand-new `.env` gets a generated DEMO_USER_PASSWORD. Empty it afterwards to skip the demo user
# (then sign in as Administrator).
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_NAME=Demo User
DEMO_USER_PASSWORD=

# ── Frontend: Next.js ────────────────────────────────────────────────────────────────────────────────
# Port for `next dev` / `next start`.
PORT=3000

# Where the Next.js *server* reaches Frappe. Server-side only: it is never sent to the browser.
# Use 127.0.0.1, not localhost: Node may resolve localhost to ::1, where Frappe isn't listening.
FRAPPE_URL=http://127.0.0.1:8000

# Note: the Next.js server also sends FRAPPE_SITE_NAME (above) as the X-Frappe-Site-Name header, so the
# right site is picked even when Frappe isn't pinned to one or sits behind a proxy that rewrites Host.
